V "GNAT Lib v14"
A -gnatA
A -gnatwa
A -mmacosx-version-min=15.0.0
A -mcpu=apple-m1
A -mlittle-endian
A -mabi=lp64
A -fPIC
P SS ZX

RN
RV NO_DIRECT_BOOLEAN_OPERATORS
RV NO_SECONDARY_STACK
RV NO_STANDARD_STORAGE_POOLS
RV NO_IMPLEMENTATION_ASPECT_SPECIFICATIONS
RV NO_IMPLEMENTATION_PRAGMAS

U traffic_control%b	traffic_control.adb	7b95234c NE OO PK
Z system.secondary_stack%s  s-secsta.adb	s-secsta.ali

U traffic_control%s	traffic_control.ads	bcef7293 EE NE OO PK

