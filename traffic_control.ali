G c Z s b [to_string traffic_control 13 13 none]
G c Z s b [safe traffic_control 18 13 none]
G c Z s b [next_state traffic_control 23 14 none]
G c Z s s [junction_stateIP traffic_control 7 9 none]
G c Z b b [main_g traffic_control 32 13 none]
G c Z b b [side_g traffic_control 39 13 none]
G c Z b b [ped_g traffic_control 46 13 none]
